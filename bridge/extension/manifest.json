{
  "manifest_version": 3,
  "name": "Relay",
  "description": "Comparte con Relay solo las pestañas que eliges, para controlarlas desde tu teléfono.",
  "version": "1.0.0",
  "minimum_chrome_version": "154",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "tabs", "storage", "alarms", "downloads"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Compartir esta pestaña con Relay" }
}
